# ==============================================================================
# EvidenceOS Configuration Template (.env.example)
# ==============================================================================

# --- Application Server Configuration ---
# Runtime deployment environment (development, staging, or production)
ENVIRONMENT=development
# Port number for the FastAPI backend server
PORT=8000
# Comma-separated CORS origins or * for open development access
CORS_ORIGINS=*

# --- Database Storage ---
# SQLAlchemy async database connection URI (SQLite aiosqlite or PostgreSQL asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./evidenceos.db

# --- LLM Planning & Value Scoring ---
# Anthropic Claude API key for claim decomposition planning and value density estimation
CLAUDE_API_KEY=sk-ant-api03-template-key-change-me

# --- x402 Micropayment Protocol & EVM Settlement (Base Sepolia Testnet) ---
# EVM Chain ID for Base Sepolia testnet settlement (84532)
CHAIN_ID=84532
# Public JSON-RPC endpoint for Base Sepolia testnet blockchain interaction
RPC_URL=https://sepolia.base.org
# USDC ERC-20 contract address on Base Sepolia testnet
USDC_CONTRACT_ADDRESS=0x036Cb52701cb08910E44913b865d06799f7f93b3
# Private key for the client x402 payment signer wallet (must be funded with Base Sepolia ETH + USDC)
X402_PRIVATE_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a6f363852
# Fallback private key variable for x402 payment client initialization
WALLET_PRIVATE_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a6f363852
# Explicit recipient address for receiving x402 micropayments (defaults to derived address)
PAYMENT_RECIPIENT_ADDRESS=0xcF107c0D3537878010Df6b8B8d439a92D08AD18d
# x402 protocol facilitator API endpoint for payment authorization verification
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- External Paid APIs ---
# NewsAPI.org API key for fetching real live news articles in /api/v1/paid-news
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE
