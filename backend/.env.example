# ==============================================================================
# EvidenceOS Configuration Template (.env.example)
# Multi-LLM Real AI Agents & Real Web Search Configuration
# ==============================================================================

# --- Application Server Configuration ---
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=*

# --- Database Storage ---
DATABASE_URL=sqlite+aiosqlite:///./evidenceos.db

# --- REAL AI AGENT LLM PROVIDERS (Provide any one API Key) ---
# Option 1: Free Grok (xAI) API Key (https://console.x.ai/)
XAI_API_KEY=your_xai_grok_api_key_here

# Option 2: Free Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Option 3: Free Groq API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Option 4: OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Option 5: OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 6: Anthropic Claude API Key (https://console.anthropic.com/)
CLAUDE_API_KEY=your_claude_api_key_here

# --- REAL WEB SEARCH & PAID NEWS APIS ---
# NewsAPI.org API Key for live global news articles (https://newsapi.org/)
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE

# --- x402 Micropayment Protocol & EVM Settlement (Base Sepolia Testnet) ---
