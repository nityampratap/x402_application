# .env.example
# EvidenceOS Environment Configuration

# x402 Payment Configuration (Base Sepolia Testnet)
CHAIN_ID=84532
USDC_CONTRACT_ADDRESS=0x036Cb52701cb08910E44913b865d06799f7f93b3
X402_FACILITATOR_URL=https://x402.org/facilitator

# Private key for the x402 payment signer wallet (fund with testnet USDC)
X402_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: explicit seller address (defaults to address derived from key above)
# PAYMENT_RECIPIENT_ADDRESS=0xYOUR_RECIPIENT_ADDRESS

# NewsAPI.org free-tier key for /api/v1/paid-news endpoint
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE

# Optional
# CLAUDE_API_KEY=sk-ant-...
# DATABASE_URL=sqlite+aiosqlite:///./evidenceos.db
